{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mt5-assistant.local/schemas/request.schema.json",
  "title": "MT5 Assistant process request",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "protocolVersion", "requestId", "operation", "payload"],
  "properties": {
    "kind": { "const": "request" },
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payload": { "type": "object" }
  }
}
